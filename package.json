{
  "name": "telegram-agent-framework",
  "version": "0.1.0",
  "main": "function.js",
  "type": "module",
  "scripts": {
    "dev": "node src/dev.ts",
    "start:webhook": "functions-framework --source=src/main.ts --target=handleHttp --signature-type=http",
    "start:worker": "functions-framework --source=src/main.ts --target=handleCloudEvent --signature-type=cloudevent"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/pubsub": "^5.3.0",
    "@openai/agents": "^0.8.5",
    "dotenv": "^17.4.2",
    "mongodb": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
